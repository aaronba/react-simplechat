# Microsoft Entra ID (Azure AD) Configuration
# Copy this file to .env.local and fill in your actual values

# Your App Registration Client ID from Azure Portal
VITE_CLIENT_ID=your-client-id-here

# Your tenant ID or domain name  
# Format: https://login.microsoftonline.com/{tenant-id}
# Or: https://login.microsoftonline.com/{your-domain.onmicrosoft.com}
VITE_AUTHORITY=https://login.microsoftonline.com/your-tenant-id-here

# Redirect URI (usually your app's URL)
VITE_REDIRECT_URI=http://localhost:5173

# Optional: Custom scopes if needed
VITE_SCOPES=User.Read,openid,profile,email
